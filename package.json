{
  "name": "shiki-transformer-color-highlight",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@10.29.3",
  "description": "Shiki transformer that highlights colors",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/shiki-transformer-color-highlight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/shiki-transformer-color-highlight.git"
  },
  "bugs": "https://github.com/antfu/shiki-transformer-color-highlight/issues",
  "keywords": [
    "shiki",
    "shiki-transformer"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@shikijs/core": "^3.22.0",
    "@shikijs/types": "^3.22.0",
    "colorjs.io": "^0.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@antfu/ni": "^28.2.0",
    "@antfu/utils": "^9.3.0",
    "@types/node": "^25.2.3",
    "bumpp": "^10.4.1",
    "eslint": "^10.0.0",
    "lint-staged": "^16.2.7",
    "pnpm": "^10.29.3",
    "shiki": "^3.22.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite": "^7.3.1",
    "vitepress": "^2.0.0-alpha.16",
    "vitest": "^4.0.18"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
